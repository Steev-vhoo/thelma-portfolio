# ── Google Drive (Projects section) ─────────────────────────────
# 1. Put project files in a Drive folder (sub-folders become filter tabs,
#    e.g. "Campaigns", "Assignments").
# 2. Share the folder: "Anyone with the link → Viewer".
# 3. Copy the folder ID from its URL: drive.google.com/drive/folders/<THIS_PART>
GOOGLE_DRIVE_FOLDER_ID=
# Google Cloud Console → enable "Google Drive API" → Credentials → API key
# (restrict it to the Drive API).
GOOGLE_DRIVE_API_KEY=

# ── Google Drive (Videos section) ───────────────────────────────
# Optional: a separate folder for videos (shared the same way, "Anyone with the link → Viewer").
# Leave empty to show the video files found in the projects folder above instead
# (they then move out of the Projects grid so nothing appears twice).
GOOGLE_DRIVE_VIDEOS_FOLDER_ID=
